{
    "name": "@1001tales/paper",
    "private": true,
    "packageManager": "yarn@4.9.3",
    "scripts": {
        "lint:wall": "chktex -q -n22 -n30 -n35 -e16 -Wall main.tex",
        "lint": "chktex -q -n22 -n30 -e16 main.tex",
        "format": "tex-fmt main.tex --recursive --nowrap --tabsize 2",
        "format:check": "tex-fmt --check main.tex --recursive --nowrap --tabsize 2",
        "build": "latexmk -pdf -interaction=nonstopmode main.tex",
        "dev": "latexmk -silent -pdf -pvc -interaction=nonstopmode main.tex",
        "test": "echo \"No tests configured for paper\"",
        "clean": "latexmk -c main.tex"
    }
}
