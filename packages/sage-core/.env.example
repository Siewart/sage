# Templates run locally without a model or API key.
SAGE_REALISER=templates

# For model generation, select gemini, anthropic or openai above, set an explicit
# model identifier, and supply the matching provider key when required.
# SAGE_MODEL=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional OpenAI-compatible server. Loopback servers do not require an API key.
# SAGE_BASE_URL=http://localhost:11434/v1
