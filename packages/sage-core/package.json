{
  "name": "sage-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noCheck && cpx \"../simplenlg-core/src/**/*.xml\" dist/simplenlg-core/src/ && cpx \"../simplenlg-core/LexAccessCopyright.MD\" dist/simplenlg-core/",
    "gen": "node --import tsx gen/cli.ts",
    "format": "prettier --write src gen test",
    "format:check": "prettier --check src gen test",
    "test:generate": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand test/generate",
    "test:generate:t1": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand -t \"T1\" test/generate",
    "test:data": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand --watchman=false --silent test/data",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apache-arrow/ts": "20.0.0",
    "@google/genai": "1.0.1",
    "arquero": "8.0.1",
    "clipanion": "4.0.0-rc.4",
    "dotenv": "16.5.0",
    "fast-xml-parser": "4.5.1",
    "remeda": "2.23.1",
    "zod": "3.25.76",
    "simplenlg-core": "workspace:*",
    "@sage/data": "workspace:*",
    "@sage/contracts": "workspace:*",
    "@sage/llm": "workspace:*"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@types/jest": "29.5.14",
    "cpx": "1.5.0",
    "jest": "29.7.0",
    "prettier": "3.6.2",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "tsx": "4.20.4",
    "typescript": "5.8.2"
  }
}
